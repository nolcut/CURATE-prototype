# ── LLM credentials ───────────────────────────────────────────────────────────
# Default: AWS Bedrock. Set a Bedrock API key (BedrockAPIKey-xxxx from the
# Bedrock console), OR use AWS IAM credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an AWS_PROFILE instead.
BEDROCK_API_KEY=
AWS_REGION=us-east-1

# Optional: direct Anthropic API (sk-ant-... from console.anthropic.com).
# ONLY used when the CLI is run with --anthropic-api; ignored otherwise.
ANTHROPIC_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
GH_PAT=                     # personal access token with repo + actions scopes
FAASR_GH_USERNAME=          # your GitHub username
FAASR_ACTION_REPO=          # repo where function code and Actions workflows live

# ── S3-compatible storage ─────────────────────────────────────────────────────
FAASR_S3_ENDPOINT=https://s3.amazonaws.com
FAASR_S3_BUCKET=
FAASR_S3_REGION=us-east-1
S3_AccessKey=
S3_SecretKey=
